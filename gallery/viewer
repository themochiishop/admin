<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>gallery</title>
    <style>
        /* 全局重置与基础样式 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            background: #1a1e2b;
            min-height: 100vh;
            min-height: 100dvh; /* 移动端动态视口高度 */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: system-ui, 'Segoe UI', Roboto, sans-serif;
            padding: clamp(0.5rem, 3vw, 1.5rem);
        }

        /* 卡片式容器 —— 宽度自适应，最大1000px */
        .slider-container {
            width: 100%;
            max-width: 1000px;
            background: #0f1219;
            border-radius: clamp(1rem, 3vw, 2rem);
            padding: clamp(0.75rem, 2.5vw, 1.5rem) clamp(0.75rem, 2.5vw, 1.5rem) clamp(0.5rem, 1.5vw, 1rem);
            box-shadow: 0 25px 40px -12px rgba(0, 0, 0, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            flex-direction: column;
        }

        /* 滑动视口 */
        .slider-viewport {
            overflow: hidden;
            border-radius: clamp(0.75rem, 2vw, 1.25rem);
            background: #1e2330;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
            /* 关键：width 100%，高度由内容撑开，但为了稳定，可设min-height以防图片加载时抖动 */
            width: 100%;
        }

        /* 滑动轨道 */
        .slider-track {
            display: flex;
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            will-change: transform;
            /* 保证轨道高度与内容一致 */
        }

        /* 每一张幻灯片 */
        .slide {
            flex: 0 0 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(0.4rem, 1.5vw, 0.75rem);
        }

        /* 图片自适应：宽度100%，高度按比例，限制最大高度避免过高 */
        .slide img {
            display: block;
            width: 100%;
            height: auto;
            max-height: min(460px, 60vh); /* 根据视口高度限制，避免大屏过高 */
            object-fit: cover;
            border-radius: clamp(0.5rem, 1.5vw, 1rem);
            box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.5);
            transition: transform 0.2s;
            user-select: none;
            -webkit-user-drag: none;
        }

        /* 导航按钮容器 */
        .slider-nav {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: clamp(0.75rem, 3vw, 1.5rem);
            margin-top: clamp(0.75rem, 2vw, 1.25rem);
            margin-bottom: clamp(0.25rem, 1vw, 0.5rem);
        }

        /* 按钮样式 */
        .nav-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #eef2f8;
            width: clamp(2.4rem, 6vw, 3rem);
            height: clamp(2.4rem, 6vw, 3rem);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(1.2rem, 4vw, 1.8rem);
            font-weight: 300;
            line-height: 1;
            cursor: pointer;
            transition: all 0.2s ease;
            backdrop-filter: blur(4px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            user-select: none;
            flex-shrink: 0;
        }

        .nav-btn:hover {
            background: #4f7cff;
            border-color: #4f7cff;
            color: white;
            transform: scale(1.05);
            box-shadow: 0 8px 18px -6px #4f7cff;
        }

        .nav-btn:active {
            transform: scale(0.96);
            background: #3b62cc;
        }

        /* 页码指示器 */
        .page-indicator {
            color: #aab3cd;
            font-size: clamp(0.9rem, 2.8vw, 1.1rem);
            font-weight: 500;
            letter-spacing: 0.03em;
            background: rgba(0, 0, 0, 0.35);
            padding: 0.4em 1em;
            border-radius: 3rem;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            min-width: 4.5em;
            text-align: center;
            white-space: nowrap;
        }

        /* 圆点导航 */
        .dots {
            display: flex;
            justify-content: center;
            gap: clamp(0.5rem, 2vw, 0.8rem);
            margin-top: 0.5rem;
            padding: 0.5rem 0 0.2rem;
            flex-wrap: wrap;
        }

        .dot {
            width: clamp(8px, 2vw, 10px);
            height: clamp(8px, 2vw, 10px);
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            padding: 0;
            cursor: pointer;
            transition: all 0.25s ease;
            outline: none;
            flex-shrink: 0;
        }

        .dot.active {
            background: #4f7cff;
            transform: scale(1.4);
            box-shadow: 0 0 12px #4f7cff;
        }

        .dot:hover {
            background: #7f9eff;
        }

        /* 提示文字 */
        .hint {
            margin-top: 0.75rem;
            font-size: clamp(0.7rem, 2vw, 0.85rem);
            color: #6b7a9c;
            text-align: center;
            letter-spacing: 0.3px;
        }

        /* 针对特别小的屏幕 (e.g., 320px) 微调 */
        @media (max-width: 380px) {
            .slider-nav {
                gap: 0.5rem;
            }
            .page-indicator {
                min-width: 3.8em;
                padding: 0.3em 0.6em;
            }
            .dot {
                width: 7px;
                height: 7px;
            }
        }

        /* 横屏手机：避免图片过高 */
        @media (orientation: landscape) and (max-height: 500px) {
            .slide img {
                max-height: 45vh;
            }
            .slider-nav {
                margin-top: 0.5rem;
            }
            .hint {
                display: none; /* 横屏空间有限，隐藏提示 */
            }
        }
    </style>
</head>
<body>
    <div class="slider-container">
        <div class="slider-viewport" id="sliderViewport">
            <div class="slider-track" id="sliderTrack">
                <div class="slide">
                    <img src="https://picsum.photos/id/1015/1000/600" alt="山间河流" loading="lazy">
                </div>
                <div class="slide">
                    <img src="https://picsum.photos/id/1043/1000/600" alt="森林小径" loading="lazy">
                </div>
                <div class="slide">
                    <img src="https://picsum.photos/id/1074/1000/600" alt="雾中湖泊" loading="lazy">
                </div>
                <div class="slide">
                    <img src="https://picsum.photos/id/1067/1000/600" alt="金色田野" loading="lazy">
                </div>
            </div>
        </div>

        <div class="slider-nav">
            <button class="nav-btn" id="prevBtn" aria-label="上一张">←</button>
            <span class="page-indicator" id="pageIndicator">1 / 4</span>
            <button class="nav-btn" id="nextBtn" aria-label="下一张">→</button>
        </div>

        <div class="dots" id="dotsContainer"></div>
        <div class="hint">滑动/点击切换 · 自动适应屏幕</div>
    </div>

    <script>
        (function() {
            const track = document.getElementById('sliderTrack');
            const slides = track.querySelectorAll('.slide');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const pageIndicator = document.getElementById('pageIndicator');
            const dotsContainer = document.getElementById('dotsContainer');
            const viewport = document.getElementById('sliderViewport');

            const totalSlides = slides.length;
            let currentIndex = 0;
            let slideWidth = 0;

            // 更新位移和UI
            function updateSlider() {
                // 使用 translateX 移动，基于当前视口宽度
                const offset = -currentIndex * slideWidth;
                track.style.transform = `translateX(${offset}px)`;
                pageIndicator.textContent = `${currentIndex + 1} / ${totalSlides}`;

                const dots = dotsContainer.querySelectorAll('.dot');
                dots.forEach((dot, idx) => {
                    dot.classList.toggle('active', idx === currentIndex);
                });
            }

            // 测量视口宽度并更新
            function measureAndUpdate() {
                // 获取视口实际宽度（clientWidth 包含 padding，但这里 padding 是在 slide 上，viewport 本身没有水平padding，安全）
                // 注意：viewport 本身没有内边距，宽度就是内容区域宽度。
                if (viewport) {
                    slideWidth = viewport.clientWidth;
                }
                // 如果由于某些原因宽度为0，尝试从幻灯片获取
                if (slideWidth === 0 && slides[0]) {
                    slideWidth = slides[0].clientWidth;
                }
                // 重新应用位置
                updateSlider();
            }

            // 跳转到指定索引（循环）
            function goToSlide(index) {
                if (index < 0) {
                    currentIndex = totalSlides - 1;
                } else if (index >= totalSlides) {
                    currentIndex = 0;
                } else {
                    currentIndex = index;
                }
                updateSlider();
            }

            // 上一张/下一张
            function prevSlide() { goToSlide(currentIndex - 1); }
            function nextSlide() { goToSlide(currentIndex + 1); }

            // 创建圆点
            function createDots() {
                dotsContainer.innerHTML = '';
                for (let i = 0; i < totalSlides; i++) {
                    const dot = document.createElement('button');
                    dot.classList.add('dot');
                    if (i === currentIndex) dot.classList.add('active');
                    dot.setAttribute('aria-label', `切换到第 ${i + 1} 张`);
                    dot.addEventListener('click', () => goToSlide(i));
                    dotsContainer.appendChild(dot);
                }
            }

            // 初始化
            function init() {
                createDots();
                // 首次测量（页面布局完成后）
                // 确保在图片加载前也能获取正确宽度
                measureAndUpdate();

                // 按钮事件
                prevBtn.addEventListener('click', prevSlide);
                nextBtn.addEventListener('click', nextSlide);

                // 窗口尺寸变化 → 重新测量
                window.addEventListener('resize', () => {
                    // 使用 requestAnimationFrame 确保布局稳定
                    requestAnimationFrame(() => {
                        measureAndUpdate();
                    });
                });

                // 监听视口尺寸变化（如移动端旋转），使用 ResizeObserver 更精准
                if (window.ResizeObserver) {
                    const resizeObserver = new ResizeObserver(() => {
                        // 当视口尺寸变化时重新测量
                        requestAnimationFrame(() => {
                            measureAndUpdate();
                        });
                    });
                    resizeObserver.observe(viewport);
                }

                // 键盘事件
                window.addEventListener('keydown', (e) => {
                    if (e.key === 'ArrowLeft') {
                        prevSlide();
                        e.preventDefault();
                    } else if (e.key === 'ArrowRight') {
                        nextSlide();
                        e.preventDefault();
                    }
                });

                // 图片加载完成后再次测量，确保没有因图片加载导致的尺寸突变
                const images = track.querySelectorAll('img');
                images.forEach(img => {
                    if (img.complete) {
                        // 已经缓存完成
                        requestAnimationFrame(() => measureAndUpdate());
                    } else {
                        img.addEventListener('load', () => {
                            requestAnimationFrame(() => measureAndUpdate());
                        });
                        img.addEventListener('error', () => {
                            // 图片加载失败也重新测量（以防占位尺寸变化）
                            requestAnimationFrame(() => measureAndUpdate());
                        });
                    }
                });

                // 页面完全加载后最后检查一次
                window.addEventListener('load', () => {
                    measureAndUpdate();
                });
            }

            init();
        })();
    </script>
</body>
</html>
